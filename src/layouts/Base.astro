---
// 全站布局：字体、全局样式、页面切换、页眉页脚、全局播放器
import { ClientRouter } from 'astro:transitions';
import '@fontsource/noto-serif-sc/300.css';
import '@fontsource/noto-serif-sc/400.css';
import '@fontsource/cormorant-garamond/400.css';
import '@fontsource/cormorant-garamond/400-italic.css';
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/500-italic.css';
import '../styles/tokens.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Player from '../components/Player.astro';
import { getLang, htmlLang, localize, switchPath, useT } from '../i18n/ui';

interface Props {
  title?: string; // 板块名，留空则只显示站名
  description?: string;
}

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { title, description = t('site.description') } = Astro.props;
const fullTitle = title ? `${title} · anlele` : 'anlele';
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
// 两种语言互相指向，供搜索引擎识别
const zhUrl = new URL(switchPath(path, 'zh'), Astro.site);
const enUrl = new URL(switchPath(path, 'en'), Astro.site);
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <meta property="og:site_name" content="anlele" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === 'en' ? 'en_US' : 'zh_CN'} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href={localize('/rss.xml', lang)} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0C0A08" />
    <!-- 主题：页面渲染前就设好 data-theme，避免闪一下。顺序：手动选择 > 跟随系统 -->
    <script is:inline>
      (function () {
        if (window.anleleSetTheme) return;
        // 和 tokens.css 里两套 --bg 一致，用于浏览器地址栏颜色
        var BG = { dark: '#0C0A08', light: '#F2ECE2' };
        var system = matchMedia('(prefers-color-scheme: light)');
        function stored() {
          try {
            var t = localStorage.getItem('theme');
            return t === 'light' || t === 'dark' ? t : null;
          } catch (e) {
            return null;
          }
        }
        function set(t) {
          document.documentElement.dataset.theme = t;
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', BG[t]);
        }
        function apply() {
          set(stored() || (system.matches ? 'light' : 'dark'));
        }
        window.anleleSetTheme = set;
        apply();
        // 切页后 <html> 的属性会被换掉，重新设一次
        document.addEventListener('astro:after-swap', apply);
        // 没有手动选过时，系统切换深浅也跟着变
        system.addEventListener('change', function () {
          if (!stored()) apply();
        });
      })();
    </script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <Player />
  </body>
</html>
