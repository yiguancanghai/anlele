---
import View from '../../views/Word.astro';
import { getWorks } from '../../i18n/content';

export async function getStaticPaths() {
  const works = await getWorks('words', 'zh');
  return works.map((work) => ({ params: { slug: work.id }, props: { work } }));
}

const { work } = Astro.props;
---

<View work={work} />
