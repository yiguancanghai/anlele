---
// 单篇：按 kind 用三种版式（诗 / 读书笔记 / 随笔）
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PoemReader from '../../components/PoemReader.astro';
import { firstLine } from '../../scripts/text';

export async function getStaticPaths() {
  const words = await getCollection('words', ({ data }) => !data.draft);
  return words.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, kind, date, book, author, excerpt } = entry.data;
const year = date.getFullYear();
---

<Base title={title} description={excerpt ?? firstLine(entry.body)}>
  <article class="wrap piece">
    <div class="top">
      <a class="back" href="/words/">← 字</a>
      {kind === '诗' && <button type="button" data-poem-toggle>横排</button>}
    </div>

    {
      kind === '诗' && (
        <PoemReader title={title} year={year}>
          <Content />
        </PoemReader>
      )
    }

    {
      kind === '读书笔记' && (
        <div class="note rise">
          <h1>{title}</h1>
          <p class="source">
            {book && `《${book}》`}
            {author}
          </p>
          <Content />
        </div>
      )
    }

    {
      kind === '随笔' && (
        <div class="essay rise">
          <h1>{title}</h1>
          <p class="source latin">{year}</p>
          <Content />
        </div>
      )
    }
  </article>
</Base>

<style>
  .piece {
    padding-top: 48px;
    padding-bottom: 120px;
  }

  .top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 56px;
    font-size: 14px;
    color: var(--mute);
  }

  .top a,
  .top button {
    display: inline-flex;
    align-items: center;
    min-width: 44px;
    min-height: 44px;
  }

  .top button {
    justify-content: flex-end;
  }

  .top a:hover,
  .top button:hover {
    color: var(--acc);
  }

  h1 {
    font-size: 22px;
  }

  .source {
    margin-top: 4px;
    font-size: 14px;
    color: var(--mute);
  }

  .source.latin {
    font-size: 17px;
  }

  /* 读书笔记：引用块是摘录，紧跟的段落是批注 */
  .note {
    max-width: 720px;
  }

  .note :global(blockquote) {
    margin: 64px 0 0;
    font-size: 19px;
    line-height: 2.1;
  }

  .note :global(blockquote + p) {
    margin-top: 16px;
    font-size: 15px;
    color: var(--mute);
  }

  .note :global(blockquote + p::before) {
    content: '注';
    margin-right: 12px;
    font-family: var(--font-latin);
    font-style: italic;
    color: var(--acc);
  }

  /* 随笔：普通文章，窄栏 */
  .essay {
    max-width: 600px;
  }

  .essay :global(p) {
    line-height: 2.1;
  }

  .essay :global(h1 ~ p:not(.source)) {
    margin-top: 1.6em;
  }

  .essay :global(.source + p) {
    margin-top: 56px;
  }
</style>
