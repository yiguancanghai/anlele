---
// 影：短片纵向排列。以后加"摄影"时，按 kind 再分一栏即可
import { getCollection, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BiliEmbed from '../components/BiliEmbed.astro';

const all = (await getCollection('frames', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const films = await Promise.all(
  all
    .filter((f) => f.data.kind === '短片')
    .map(async (f) => ({ ...f.data, Content: (await render(f)).Content })),
);
---

<Base title="影" description="短片">
  <section class="wrap section">
    <h1 class="section-title rise">影</h1>
    <p class="section-sub rise" style="--i: 1">短片</p>

    <div class="films rise" style="--i: 2">
      {
        films.map((f) => (
          <article>
            {f.bvid && <BiliEmbed bvid={f.bvid} title={f.title} cover={f.cover} />}
            <div class="head">
              <h2>{f.title}</h2>
              <p class="latin">{[f.duration, f.date.getFullYear()].filter(Boolean).join(' · ')}</p>
            </div>
            <div class="intro">
              <f.Content />
            </div>
          </article>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .films {
    display: grid;
    gap: 96px;
    max-width: 880px;
    margin-top: 72px;
  }

  .head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    margin-top: 20px;
  }

  h2 {
    font-size: 18px;
  }

  .head .latin {
    color: var(--mute);
    white-space: nowrap;
  }

  .intro {
    max-width: 560px;
    margin-top: 8px;
    font-size: 15px;
    color: var(--mute);
  }
</style>
