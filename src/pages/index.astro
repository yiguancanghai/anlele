---
// 首页：落日 / 门口的一句诗 / 此刻 / 作品目录
import Base from '../layouts/Base.astro';
import Sunset from '../components/Sunset.astro';
import WorkIndex from '../components/WorkIndex.astro';
import { epigraph } from '../data/site';
import { Content as Now } from '../content/now.md';
---

<Base>
  <div class="wrap home">
    <h1 class="sr-only">anlele</h1>

    <Sunset />

    <div class="epigraph">
      {epigraph.lines.map((line, i) => <p class="rise" style={`--i: ${i}`}>{line}</p>)}
      <p class="source rise" style={`--i: ${epigraph.lines.length}`}>— 《{epigraph.source}》</p>
    </div>

    <section class="now rise" style="--i: 3">
      <h2 class="latin">此刻</h2>
      <Now />
    </section>

    <section class="index rise" style="--i: 4">
      <WorkIndex />
    </section>
  </div>
</Base>

<style>
  .home {
    padding-bottom: 120px;
  }

  /* 门口的一句诗 */
  .epigraph {
    margin-top: 72px;
  }

  .epigraph p {
    font-size: 30px;
    line-height: 1.9;
    letter-spacing: 0.06em;
  }

  .epigraph .source {
    margin-top: 20px;
    font-size: 13px;
    letter-spacing: 0;
    color: var(--mute);
  }

  /* 此刻 */
  .now {
    max-width: 560px;
    margin-top: 120px;
    font-size: 14px;
    color: var(--mute);
  }

  .now h2 {
    margin-bottom: 8px;
    font-size: 15px;
    color: var(--acc);
  }

  .index {
    margin-top: 120px;
  }
</style>
