---
// 声：歌的列表。点一行开始播放，播放器在全局布局里
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import TrackRow from '../components/TrackRow.astro';

const sounds = (await getCollection('sounds', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
---

<Base title="声" description="我写的歌，和 AI 一起完成。">
  <section class="wrap section">
    <h1 class="section-title rise">声</h1>
    <p class="section-sub rise" style="--i: 1">我写的歌，和 AI 一起完成。播放时可以继续去别处看看。</p>

    <ul class="rise" style="--i: 2">
      {
        sounds.map((s) => (
          <li>
            <TrackRow id={s.id} title={s.data.title} note={s.data.note} duration={s.data.duration} />
          </li>
        ))
      }
    </ul>
  </section>
</Base>

<style>
  ul {
    list-style: none;
    margin: 72px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  li {
    border-bottom: 1px solid var(--line);
  }
</style>
