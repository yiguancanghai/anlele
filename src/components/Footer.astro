---
// 页脚：左边按访客本地时间问候（客户端计算），右边域名
---

<footer class="wrap">
  <p id="greeting"></p>
  <p class="latin">anlele.org</p>
</footer>

<script>
  // 分段：0–5 / 5–11 / 11–17 / 17–20 / 20–24
  const words = {
    zh: ['深夜好', '早上好', '午后好', '傍晚好', '晚上好'],
    en: ['late night', 'good morning', 'good afternoon', 'good evening', 'good night'],
  };

  function greet() {
    const el = document.getElementById('greeting');
    if (!el) return;
    const now = new Date();
    const h = now.getHours();
    const i = h < 5 ? 0 : h < 11 ? 1 : h < 17 ? 2 : h < 20 ? 3 : 4;
    if (document.documentElement.lang === 'en') {
      // 如 "October 15 — good evening."
      const month = now.toLocaleString('en', { month: 'long' });
      el.textContent = `${month} ${now.getDate()} — ${words.en[i]}.`;
    } else {
      el.textContent = `${now.getMonth() + 1}月${now.getDate()}日，${words.zh[i]}。`;
    }
  }
  // 页面切换后页脚会被替换，所以每次都重新计算
  document.addEventListener('astro:page-load', greet);
</script>

<style>
  footer {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding-top: 28px;
    padding-bottom: 40px;
    border-top: 1px solid var(--line);
    font-size: 13px;
    color: var(--mute);
  }

  .latin {
    font-size: 16px;
  }
</style>
