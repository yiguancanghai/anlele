---
// 首页作品目录：所有板块混在一起。服务端按日期输出，客户端加载后洗牌
// 编号是 CSS 计数器（见 global.css 的 .rows），重排后自动重新编号
import Only from './Only.astro';
import { getWorks } from '../i18n/content';
import { getLang, htmlLang, kindLabel, localize, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const [words, sounds, frames, build] = await Promise.all([
  getWorks('words', lang),
  getWorks('sounds', lang),
  getWorks('frames', lang),
  getWorks('build', lang),
]);

// 每行：标题 / 类型小字 / 日期，以及跳去哪里（歌没有 href，点了直接播放）
// textLang：标题实际的语言（和页面语言不同时标出来）
const textLang = (w: { contentLang: 'zh' | 'en' }) => (w.contentLang === lang ? undefined : htmlLang(w.contentLang));
const items = [
  ...words.map((w) => ({ w, kind: w.data.kind, href: localize(`/words/${w.id}/`, lang) })),
  ...sounds.map((w) => ({ w, kind: '歌', track: w.id })),
  ...frames.map((w) => ({ w, kind: w.data.kind, href: localize('/frames/', lang) })),
  ...build.map((w) => ({ w, kind: w.data.featured ? 'App' : '项目', href: localize('/build/', lang) })),
].sort((a, b) => b.w.data.date.getTime() - a.w.data.date.getTime());
---

<div class="head">
  <p>{t('home.order')}</p>
  <button type="button" data-shuffle>{t('home.shuffle')}</button>
</div>

<ul class="rows" data-work-index>
  {
    items.map((item) => {
      const inner = (
        <>
          <span>
            <span class="row-title">
              <span lang={textLang(item.w)}>{item.w.data.title}</span>
              {item.w.missing && <Only />}
            </span>
            <span class="row-sub">{kindLabel(item.kind, lang)}</span>
          </span>
          <span class="row-meta latin">{item.w.data.date.getFullYear()}</span>
        </>
      );
      return (
        <li>
          {'track' in item ? (
            <button type="button" class="row" data-track-id={item.track} aria-pressed="false">
              {inner}
            </button>
          ) : (
            <a class="row" href={item.href}>
              {inner}
            </a>
          )}
        </li>
      );
    })
  }
</ul>

<script>
  // 洗牌：随机重排列表里的 <li>
  function shuffle() {
    const list = document.querySelector('[data-work-index]');
    if (!list) return;
    const rows = [...list.children];
    for (let i = rows.length - 1; i > 0; i--) {
      const j = Math.floor(Math.random() * (i + 1));
      [rows[i], rows[j]] = [rows[j], rows[i]];
    }
    list.append(...rows);
  }

  document.addEventListener('click', (e) => {
    if ((e.target as Element).closest('[data-shuffle]')) shuffle();
  });

  // 每次打开首页都洗一次
  shuffle();
  document.addEventListener('astro:after-swap', shuffle);
</script>

<style>
  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 12px;
    font-size: 13px;
    color: var(--mute);
  }

  .head button {
    min-height: 44px;
  }

  .head button:hover {
    color: var(--acc);
  }
</style>
