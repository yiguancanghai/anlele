---
// 一首诗的正文：每节一组，每行一块。每个字（英文是每个单词）是一个 .ch，带着构建时算好的浮现时间
// 读屏器读每行开头那份完整文字（.sr-only），逐字的部分对读屏器隐藏
import type { PoemLayout } from '../scripts/poem';

interface Props {
  layout: PoemLayout;
  lang?: string;
}
const { layout, lang } = Astro.props;
---

<div class="stanzas" lang={lang}>
  {
    layout.stanzas.map((lines) => (
      <div class="stanza">
        {lines.map((line) => (
          <span class="line">
            <span class="sr-only">{line.text}</span>
            <span aria-hidden="true">{line.tokens.map((t) => (t.delay === undefined ? t.text : <span class="ch" style={`--d:${t.delay}ms`}>{t.text}</span>))}</span>
          </span>
        ))}
      </div>
    ))
  }
</div>

<style>
  .line {
    display: block;
  }

  /* 复制时只复制看得见的那份，不重复 */
  .line > .sr-only {
    user-select: none;
  }

  .stanza + .stanza {
    margin-block-start: 1.2em;
  }
</style>
