---
// 一首诗的正文：每节一组，每行一块
import type { PoemLayout } from '../scripts/poem';

interface Props {
  layout: PoemLayout;
  lang?: string;
}
const { layout, lang } = Astro.props;
---

<div class="stanzas" lang={lang}>
  {
    layout.stanzas.map((lines) => (
      <div class="stanza">
        {lines.map((line) => (
          <span class="line">{line}</span>
        ))}
      </div>
    ))
  }
</div>

<style>
  .line {
    display: block;
  }

  .stanza + .stanza {
    margin-block-start: 1.2em;
  }
</style>
