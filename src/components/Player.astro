---
// 全局播放器：固定在页面底部，第一次点歌之前不显示
// transition:persist 让它在切换页面（包括切换语言）时原样保留；状态逻辑在 src/scripts/player.ts
// 因为切换语言时它不会重新渲染，按钮文字由 player.ts 按页面语言设置
import { getWorks } from '../i18n/content';
import { getLang, useT } from '../i18n/ui';

const t = useT(getLang(Astro.currentLocale));
const [zh, en] = await Promise.all([getWorks('sounds', 'zh'), getWorks('sounds', 'en')]);
const tracks = zh.map((s) => ({
  id: s.id,
  title: { zh: s.data.title, en: en.find((e) => e.id === s.id)?.data.title ?? s.data.title },
  audio: s.data.audio,
  duration: s.data.duration,
  cover: s.data.cover,
}));
---

<div id="player" data-tracks={JSON.stringify(tracks)} role="region" aria-label={t('player.label')} hidden transition:persist>
  <div class="progress">
    <div class="fill" data-player-fill></div>
    <input type="range" min="0" max="1000" value="0" aria-label={t('player.seek')} data-player-seek />
  </div>
  <div class="wrap bar">
    <button type="button" class="toggle" aria-label={t('player.play')} data-player-toggle>
      <svg viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
        <path class="icon-play" d="M8 5 L19 12 L8 19 Z"></path>
        <path class="icon-pause" d="M8 5 V19 M16 5 V19"></path>
      </svg>
    </button>
    <p class="title" data-player-title></p>
    <p class="time latin" data-player-time></p>
    <button type="button" class="next" data-player-next>{t('player.next')}</button>
  </div>
</div>

<script>
  import '../scripts/player';
</script>

<style>
  #player {
    position: sticky;
    bottom: 0;
    background: var(--bg);
  }

  /* 顶部 1px 进度条：底色 --line，已播放部分 --acc */
  .progress {
    position: relative;
    height: 1px;
    background: var(--line);
  }

  .fill {
    width: 0;
    height: 100%;
    background: var(--acc);
  }

  /* 看不见的滑块盖在进度条上，负责点击 / 拖动 / 键盘跳转 */
  .progress input {
    position: absolute;
    left: 0;
    top: -8px;
    width: 100%;
    height: 17px;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }

  .progress:has(input:focus-visible) {
    outline: 1px solid var(--acc);
    outline-offset: 6px;
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
    font-size: 14px;
  }

  .toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: -10px;
    color: var(--acc);
  }

  .toggle path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linejoin: round;
  }

  /* 按播放状态只显示其中一个图标 */
  #player[data-playing='true'] .icon-play,
  #player:not([data-playing='true']) .icon-pause {
    display: none;
  }

  .title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .time {
    font-size: 16px;
    color: var(--mute);
    white-space: nowrap;
  }

  .next {
    min-height: 44px;
    color: var(--mute);
    white-space: nowrap;
  }

  .next:hover {
    color: var(--acc);
  }
</style>
