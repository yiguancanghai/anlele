---
// 单曲页：歌名、说明、播放按钮 / 歌词（跟着歌走）/ 创作说明（中英共用）
//   有同名 .lrc：歌词随播放高亮，当前句逐字洇开，自动滚动，点任意一句跳到那里播放
//   没有 .lrc 但正文里有 ```lyrics 代码块：静态显示歌词
//   都没有（纯音乐）：只显示创作说明
import Base from '../layouts/Base.astro';
import Only from '../components/Only.astro';
import { getWorks, type Work } from '../i18n/content';
import { getLang, htmlLang, localize, useT, type Lang } from '../i18n/ui';
import { getLyrics, lineTokens, lyricsBlock } from '../scripts/lyrics';
import { formatTime } from '../scripts/text';

interface Props {
  work: Work<'sounds'>;
}

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const { work } = Astro.props;
const { id, data } = work;
const tag = (l: Lang) => (l === lang ? undefined : htmlLang(l));

// 同步歌词：优先用页面语言的 .lrc，没有就用另一种
const lyricsLang: Lang | undefined = getLyrics(id, lang) ? lang : getLyrics(id, lang === 'zh' ? 'en' : 'zh') ? (lang === 'zh' ? 'en' : 'zh') : undefined;
const synced = lyricsLang && getLyrics(id, lyricsLang)!.map((l) => ({ ...l, t: Math.max(0, l.t + (data.lyricsOffset ?? 0)) }));
const lines = synced?.map((l, i) => ({ ...l, tokens: lineTokens(l.text, (synced[i + 1]?.t ?? data.duration) - l.t) }));

// 没有同步歌词时，显示 ```lyrics 里的纯文本（按空行分节）
const lyricsText = lyricsBlock(work.body);
const plain = !lines ? lyricsText?.split(/\n\s*\n/).map((s) => s.split('\n')) : undefined;

// 创作说明：渲染好的正文去掉 ```lyrics 那个代码块（它是给打轴工具读的）
const squash = (s: string) => s.replace(/<[^>]+>/g, '').replace(/\s+/g, '');
const notesHtml = (work.entry.rendered?.html ?? '').replace(/<pre[\s\S]*?<\/pre>/g, (pre) =>
  lyricsText && squash(pre) === squash(lyricsText) ? '' : pre,
);

// 关联的诗
const poem = data.related ? (await getWorks('words', lang)).find((w) => w.id === data.related) : undefined;

---

<Base title={data.title} description={data.note}>
  <article class="wrap song" data-song={id}>
    <div class="tools">
      <a href={localize('/sounds/', lang)}>{t('sounds.back')}</a>
    </div>

    <header class="rise">
      <h1 lang={tag(work.contentLang)}>{data.title}</h1>
      {work.missing && <Only />}
      <p class="note" lang={tag(work.contentLang)}>{data.note}</p>
      <p class="meta">
        <span class="latin">{formatTime(data.duration)}</span>
        <button type="button" class="play" data-track-id={id} aria-pressed="false">
          <span class="off">{t('player.play')}</span>
          <span class="on">{t('player.pause')}</span>
        </button>
      </p>
    </header>

    {
      lines && (
        <div class="lyrics synced rise" style="--i: 1" data-lyrics lang={tag(lyricsLang!)} aria-label={t('sounds.lyrics')} role="group">
          {lines.map((l, i) =>
            l.text ? (
              <button type="button" class="line" data-i={i} data-t={l.t}>
                {l.tokens.map((tk) => (tk.delay === undefined ? tk.text : <span class="c" style={`--d:${tk.delay}ms`}>{tk.text}</span>))}
              </button>
            ) : (
              <span class="gap" data-i={i} aria-hidden="true" />
            ),
          )}
        </div>
      )
    }

    {
      plain && (
        <div class="lyrics static rise" style="--i: 1" lang={tag(work.contentLang)}>
          {plain.map((stanza) => (
            <p>
              {stanza.map((line) => (
                <span class="line">{line}</span>
              ))}
            </p>
          ))}
        </div>
      )
    }

    {
      notesHtml.trim() && (
        <div class="notes rise" style="--i: 2" lang={tag(work.contentLang)} set:html={notesHtml} />
      )
    }

    {
      (poem || data.tools) && (
        <dl class="facts rise" style="--i: 2">
          {poem && (
            <>
              <dt>{t('sounds.related')}</dt>
              <dd>
                <a href={localize(`/words/${poem.id}/`, lang)} lang={tag(poem.contentLang)}>
                  {poem.contentLang === 'zh' ? `《${poem.data.title}》` : poem.data.title}
                </a>
              </dd>
            </>
          )}
          {data.tools && (
            <>
              <dt>{t('sounds.tools')}</dt>
              <dd>{data.tools.join(' · ')}</dd>
            </>
          )}
        </dl>
      )
    }
  </article>
</Base>

<script>
  import type { LyricState } from '../scripts/player';

  let pauseUntil = 0; // 用户手动滚动后，暂停自动滚动到这个时间
  let resume: ReturnType<typeof setTimeout> | undefined;
  let last: LyricState | undefined; // 最近一次的歌词状态，恢复自动滚动时用
  const reduced = () => matchMedia('(prefers-reduced-motion: reduce)').matches;

  // 根据播放器的歌词状态，标出唱过的 / 正在唱的 / 还没唱的
  function update(state: LyricState) {
    last = state;
    const song = document.querySelector<HTMLElement>('[data-song]');
    const box = song?.querySelector<HTMLElement>('[data-lyrics]');
    if (!song || !box) return;
    const active = state.playing && state.id === song.dataset.song;
    box.dataset.active = String(active);
    let now: HTMLElement | undefined;
    box.querySelectorAll<HTMLElement>('[data-i]').forEach((el) => {
      const i = Number(el.dataset.i);
      el.classList.toggle('past', active && i < state.index);
      el.classList.toggle('now', active && i === state.index);
      el.classList.toggle('next', active && i > state.index);
      if (active && i === state.index) now = el;
    });
    // 当前句保持在歌词区偏上约 40% 的位置
    if (now && Date.now() > pauseUntil) {
      const top = now.offsetTop - box.clientHeight * 0.4 + now.offsetHeight / 2;
      box.scrollTo({ top, behavior: reduced() ? 'auto' : 'smooth' });
    }
  }

  document.addEventListener('player:lyric', (e) => update((e as CustomEvent<LyricState>).detail));

  // 点击某一句：跳到那个时间播放
  document.addEventListener('click', (e) => {
    const line = (e.target as Element).closest<HTMLElement>('[data-lyrics] [data-t]');
    const song = document.querySelector<HTMLElement>('[data-song]');
    if (!line || !song) return;
    document.dispatchEvent(new CustomEvent('player:seek', { detail: { id: song.dataset.song, t: Number(line.dataset.t) } }));
  });

  function init() {
    const box = document.querySelector<HTMLElement>('[data-lyrics]');
    if (!box) return;
    // 手动滚动后暂停自动滚动约 4 秒
    const hold = () => {
      pauseUntil = Date.now() + 4000;
      clearTimeout(resume);
      resume = setTimeout(() => last && update(last), 4000); // 4 秒后滚回当前句
    };
    box.addEventListener('wheel', hold, { passive: true });
    box.addEventListener('touchmove', hold, { passive: true });
    document.dispatchEvent(new CustomEvent('player:ask')); // 打开页面时先同步一次
  }
  init();
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .song {
    padding-top: 24px;
    padding-bottom: 120px;
  }

  .tools {
    font-size: 14px;
    color: var(--mute);
  }

  .tools a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .tools a:hover {
    color: var(--acc);
  }

  header {
    margin-top: 32px;
    text-align: center;
  }

  h1 {
    display: inline;
    font-size: 24px;
    letter-spacing: 0.12em;
  }

  .note {
    margin-top: 8px;
    font-size: 14px;
    color: var(--mute);
  }

  .meta {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 4px;
    color: var(--mute);
  }

  .meta .latin {
    font-size: 16px;
  }

  .play {
    min-width: 44px;
    min-height: 44px;
    font-size: 14px;
    color: var(--acc);
  }

  /* 播放 / 暂停 两个字随播放器状态切换 */
  .play[aria-pressed='true'] .off,
  .play:not([aria-pressed='true']) .on {
    display: none;
  }

  /* ---------- 歌词 ---------- */
  .lyrics {
    max-width: 640px;
    margin: 48px auto 0;
    text-align: center;
    font-size: 20px;
    line-height: 2.2;
    color: var(--mute);
  }

  /* 同步歌词：一个可以滚动的区域，上下留白让第一句和最后一句也能停在偏上 40% 处 */
  .synced {
    height: min(60svh, 560px);
    overflow-y: auto;
    padding: 22svh 0 36svh;
    scrollbar-width: thin;
    scrollbar-color: var(--line) transparent;
  }

  .synced .line {
    display: block;
    width: 100%;
    min-height: 44px;
    transition:
      color 0.4s ease,
      opacity 0.4s ease;
  }

  .synced .line:hover {
    color: var(--ink);
  }

  /* 播放这首歌时：唱过的最淡，没唱的次之，正在唱的是正文色 */
  .synced .past {
    opacity: 0.35;
  }

  .synced .next {
    opacity: 0.5;
  }

  .synced .now {
    color: var(--ink);
  }

  .now .c {
    animation: ink 0.7s ease-out both;
    animation-delay: var(--d);
  }

  @keyframes ink {
    from {
      opacity: 0;
      filter: blur(6px);
    }
  }

  /* 间奏：一个淡淡的小圆点 */
  .gap {
    display: grid;
    place-items: center;
    height: 44px;
    opacity: 0.5;
  }

  .gap::before {
    content: '';
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--mute);
  }

  .gap.past {
    opacity: 0.35;
  }

  /* 静态歌词（还没打时间轴） */
  .static p + p {
    margin-top: 1.4em;
  }

  .static .line {
    display: block;
  }

  /* ---------- 创作说明 ---------- */
  .notes {
    max-width: 600px;
    margin: 64px auto 0;
    font-size: 15px;
    line-height: 2.1;
    color: var(--mute);
  }

  .notes :global(p + p) {
    margin-top: 1.2em;
  }

  .facts {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0 20px;
    max-width: 600px;
    margin: 32px auto 0;
    font-size: 14px;
    color: var(--mute);
  }

  .facts dd {
    margin: 0;
    color: var(--ink);
  }

  .facts a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .facts dt {
    display: flex;
    align-items: center;
    min-height: 44px;
  }

  .facts a:hover {
    color: var(--acc);
  }
</style>
