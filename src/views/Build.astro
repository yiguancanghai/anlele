---
// 造：featured 的项目（Mirror AI）重点介绍，其余列在"其他"（中英共用）
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Only from '../components/Only.astro';
import { getWorks } from '../i18n/content';
import { getLang, htmlLang, useT } from '../i18n/ui';

const lang = getLang(Astro.currentLocale);
const t = useT(lang);
const all = await getWorks('build', lang);
const featured = all.find((b) => b.data.featured);
const others = all.filter((b) => b !== featured);
const Why = featured && (await render(featured.entry)).Content;
const textLang = (w: { contentLang: 'zh' | 'en' }) => (w.contentLang === lang ? undefined : htmlLang(w.contentLang));
const roman = ['i', 'ii', 'iii', 'iv', 'v', 'vi'];
---

<Base title={t('nav.build')} description={t('build.sub')}>
  <section class="wrap section">
    <h1 class="section-title rise">{t('nav.build')}</h1>
    <p class="section-sub rise" style="--i: 1">{t('build.sub')}</p>

    {
      featured && Why && (
        <div class="featured rise" style="--i: 2">
          <div class="phone">
            {featured.data.screenshot ? (
              <img src={featured.data.screenshot} alt={`${featured.data.title} ${t('build.screenshot')}`} loading="lazy" />
            ) : (
              <span>{t('build.screenshot')}</span>
            )}
          </div>
          <div class="info">
            <h2 class="latin">
              {featured.data.title}
              {featured.missing && <Only />}
            </h2>
            <p class="tagline" lang={textLang(featured)}>{featured.data.tagline}</p>
            <div class="why" lang={textLang(featured)}>
              <Why />
            </div>
            {featured.data.features && (
              <ol lang={textLang(featured)}>
                {featured.data.features.map((f, i) => (
                  <li>
                    <span class="latin">{roman[i]}</span>
                    {f}
                  </li>
                ))}
              </ol>
            )}
            {featured.data.url && (
              <a class="visit" href={featured.data.url}>
                {t('build.visit')} {featured.data.title} →
              </a>
            )}
          </div>
        </div>
      )
    }

    {
      others.length > 0 && (
        <>
          <h2 class="other-title rise" style="--i: 3">{t('build.other')}</h2>
          <ul class="rows rise" style="--i: 3">
            {others.map((b) => {
              const Tag = b.data.url ? 'a' : 'div';
              return (
                <li>
                  <Tag class="row" href={b.data.url}>
                    <span>
                      <span class="row-title">
                        <span lang={textLang(b)}>{b.data.title}</span>
                        {b.missing && <Only />}
                      </span>
                      <span class="row-sub" lang={textLang(b)}>{b.data.tagline}</span>
                    </span>
                    <span class="row-meta latin">{b.data.date.getFullYear()}</span>
                  </Tag>
                </li>
              );
            })}
          </ul>
        </>
      )
    }
  </section>
</Base>

<style>
  .featured {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 72px;
    align-items: start;
    margin-top: 72px;
  }

  /* 手机比例的截图框 */
  .phone {
    aspect-ratio: 9 / 19;
    display: grid;
    place-items: center;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 32px;
    font-size: 13px;
    color: var(--mute);
  }

  .phone img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .info {
    max-width: 560px;
  }

  .info h2 {
    font-size: 44px;
    line-height: 1.2;
  }

  .tagline {
    margin-top: 12px;
    font-size: 18px;
  }

  .why {
    margin-top: 28px;
    font-size: 15px;
    color: var(--mute);
  }

  ol {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }

  ol li {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
    font-size: 15px;
  }

  ol .latin {
    font-size: 17px;
    color: var(--mute);
  }

  .visit {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 28px;
    font-size: 15px;
    color: var(--acc);
  }

  .other-title {
    margin: 120px 0 20px;
    font-size: 14px;
    color: var(--mute);
  }

  /* 手机宽度：上下堆叠 */
  @media (max-width: 720px) {
    .featured {
      grid-template-columns: 1fr;
      gap: 48px;
    }

    .phone {
      width: min(240px, 70%);
    }
  }
</style>
